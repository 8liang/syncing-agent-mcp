#!/bin/zsh
# Generic stdio <-> HTTP bridge and workspace MCP dispatcher for Antigravity / Zcode.
#
# Usage:
#   mcp_stdio_bridge [--use-mcp-remote] <url> ["Header: value" ...]
#   mcp_stdio_bridge --expand "string with ${VAR} or ${env:VAR}"
#   mcp_stdio_bridge --workspace <server_name> [--fallback-http <url> ["Header: value" ...]]
#
# Delegates immediately to the unified Node runtime (mcp_http_stdio_bridge.mjs)
# so --workspace routing, ${VAR} expansion, and Streamable HTTP forwarding run
# in a single Node process (no python3 cold-start or multi-shell hop).
emulate -L zsh

export PATH="${PATH}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

if ! command -v node >/dev/null 2>&1; then
  for d in "$HOME/.volta/bin" "$HOME/.fnm/current/bin" "$HOME/.asdf/shims"; do
    [[ -x "$d/node" ]] && export PATH="$d:$PATH" && break
  done
fi

if ! command -v node >/dev/null 2>&1; then
  typeset -a nvm_bins
  nvm_bins=("$HOME"/.nvm/versions/node/*/bin(NOn))
  if (( ${#nvm_bins} > 0 )) && [[ -x "${nvm_bins[1]}/node" ]]; then
    export PATH="${nvm_bins[1]}:$PATH"
  fi
fi

if ! command -v node >/dev/null 2>&1; then
  {
    [[ -f "$HOME/.config/mcp-bridge.env" ]] && source "$HOME/.config/mcp-bridge.env"
    [[ -f "$HOME/.zshenv" ]] && source "$HOME/.zshenv"
  } >&2
fi

bridge_abs=${0:A}
exec node "${bridge_abs:h}/mcp_http_stdio_bridge.mjs" --bridge-path "$bridge_abs" "$@"
